# Copy to .env.local for development, and set the same variables in Vercel.

# Secret used to sign the session cookie (HMAC-SHA256).
# Generate one with: openssl rand -base64 32
# Required in production — the app refuses to sign sessions without it.
AUTH_SECRET=

# Demo credentials for /admin. Defaults are admin@example.com / admin123.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Override only if you proxy FakeStoreAPI. Defaults to https://fakestoreapi.com
# API_BASE_URL=https://fakestoreapi.com
